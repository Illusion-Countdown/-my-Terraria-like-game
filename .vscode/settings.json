  //   "background-size": "cover",
  //   "opacity": 0.15
  // },
  "editor.tabCompletion": "on",
  "editor.bracketPairColorization.enabled": false,
  // ===== Comment Anchors：关闭锚点标签的自动补全（避免误触）=====
  // 只关闭自动补全建议，不影响锚点的显示/高亮/导航功能。
  // 仍可在注释里手动输入 ANCHOR:、TODO: 等标签，它们会被正常识别。
  "commentAnchors.tags.provideAutoCompletion": false,
  "commentAnchors.epic.provideAutoCompletion": false,
  // ===== TabOut：按 Tab 跳出括号/引号 =====
  "tabout.defaults": {
    "enable": true,
    "tab": true,
    "shiftTab": false,
    "emptyLine": true,
    "multiline": true
  },
  "editor.formatOnSave": true,
  // ===== C++ 保存时自动格式化（使用 clang-format）=====
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, IndentWidth: 4, UseTab: Always, TabWidth: 4, BreakBeforeBraces: Allman, ColumnLimit: 0, SortIncludes: false, AccessModifierOffset: -4 }",
  // ===== Python 保存时自动格式化（使用 autopep8）=====
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8",
    "editor.formatOnSave": true
  },
  "autopep8.args": [
    "--max-line-length=120",
    "--ignore=E731,E701"
  ],
  //ANCHOR -字体  ===== 编辑器字体：汉字使用幼圆 =====
  "editor.fontFamily": "Consolas, '宋体', 'SimSun', monospace",
  "files.exclude": {
    // 隐藏所有可执行文件
    "**/*.exe": true,
    "**/*.dll": true,
    "**/*.lib": true,
    "**/*.pdb": true,
    // 隐藏 Visual Studio 项目文件
    "**/*.vcxproj": true,
    "**/*.vcxproj.filters": true,
    "**/*.vcxproj.user": true,
    "**/*.slnx": true,
    "**/*.sln": true,
    // 隐藏构建输出目录
    "**/x64/**": true,
    "**/Debug/**": true,
    "**/Release/**": true,
    "**/.vs/**": true,
    // 隐藏下载、临时等非源码目录
    "**/downloads/**": true,
    "**/temp/**": true,
    "**/build/**": true,
    // （可选）如果你不想看 .vscode 自身配置文件夹
    // ".vscode/**": true,
    // （可选）隐藏 node_modules / __pycache__ 等
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.git/**": true
  },
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    ".",
    "-p",
    "*test.py"
  ],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  // ===== Python 解释器：固定使用系统 Python（已装 pygame-ce）=====
  "python.defaultInterpreterPath": "C:\\Users\\wzz08\\AppData\\Local\\Programs\\Python\\Python314\\python.exe",
  // ===== 文件编码：统一 UTF-8 =====
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  // ===== Python 编码：强制 UTF-8 =====
  "python.terminal.executeInFileDir": true,
  "terminal.integrated.env.windows": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  // ===== 终端编码：统一 UTF-8 =====
  "terminal.integrated.defaultEncoding": "utf8",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "chcp 65001 > $null; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; [Console]::InputEncoding = [System.Text.Encoding]::UTF8; $OutputEncoding = [System.Text.Encoding]::UTF8"
      ]
    }
  },
  // ===== 访问修饰符 public/private/protected 颜色：深灰色 =====
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          // 注释（偏暗的灰色 + 斜体，类似 PyCharm）
          "comment",
          "comment.line",
          "comment.block",
          "comment.line.double-slash.cpp",
          "comment.block.cpp"
        ],
        "settings": {
          "foreground": "#6E6E6E",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          // C++ 访问修饰符
          "storage.modifier.access.cpp",
          "storage.type.modifier.access.cpp",
          // C# 访问修饰符
          "storage.modifier.access.cs",
          // Java 访问修饰符
          "storage.modifier.access.java",
          // 通用访问修饰符
          "storage.modifier.access",
          "storage.type.modifier.access"
        ],
        "settings": {
          "foreground": "#5A5A5A",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // C++ template 关键字
          "storage.type.template.cpp",
          "keyword.control.template.cpp",
          "storage.type.template",
          "keyword.control.template"
        ],
        "settings": {
          "foreground": "#5A3A8A",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // C++ 内置类型 int/char/long/double/float 等
          "storage.type.built-in.cpp",
          "storage.type.primitive.cpp",
          "storage.type.builtin.cpp",
          "storage.type.built-in",
          "storage.type.primitive"
        ],
        "settings": {
          "foreground": "#4090e1",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // C++ class 关键字
          "storage.type.class.cpp",
          "keyword.declaration.class.cpp",
          "storage.type.class",
          "keyword.declaration.class"
        ],
        "settings": {
          "foreground": "#9FD0E8",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // 形式变量（函数参数）
          "variable.parameter.cpp",
          "variable.parameter.function.cpp",
          "variable.parameter"
        ],
        "settings": {
          "foreground": "#909090",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // 大括号 {}（代码块）
          "punctuation.section.block.cpp",
          "punctuation.definition.block.cpp",
          "punctuation.section.block",
          "punctuation.definition.block"
        ],
        "settings": {
          "foreground": "#C0C0C0",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // 普通变量名（如 Snezhnaya）
          "variable.other.cpp",
          "variable.other.object.cpp",
          "variable.cpp",
          "variable.other"
        ],
        "settings": {
          "foreground": "#B8D4EC",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // 字符串字面量（"" 内文字）#febde3 #f7bee0
          "string.quoted.double.cpp",
          "string.quoted.double",
          "string.quoted"
        ],
        "settings": {
          "foreground": "#f7bee0",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // 命名空间（如 std）—— 偏浅葱色的白色
          "entity.name.namespace.cpp",
          "namespace.cpp",
          "entity.name.namespace",
          // 作用域解析运算符 ::
          "punctuation.accessor.cpp",
          "punctuation.accessor",
          "punctuation.separator.cpp",
          "punctuation.separator"
        ],
        "settings": {
          "foreground": "#C8F5E0",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // 类型名（如 pair、string、map、iterator）
          "entity.name.type.cpp",
          "entity.name.type",
          "storage.type.cpp",
          "storage.type"
        ],
        "settings": {
          "foreground": "#E0E0E0",
          "fontStyle": ""
        }
      },
      {
        "scope": [
          // Python f-string 插值花括号 {}（如 f"{i[0]}"）
          "constant.character.format.placeholder.other.python"
        ],
        "settings": {
          "foreground": "#d7d6d6",
          "fontStyle": ""
        }
      },
      {
        "scope": [ //原来:#b5cea8 #f8ffbee9 #C8F5E0 #FF6B81 #C86BB0 #B85A7A
          // 数字字面量（整数、浮点数等）
          "constant.numeric.cpp",
          "constant.numeric",
          "constant.numeric.decimal",
          "constant.numeric.integer",
          "constant.numeric.float"
        ],
        "settings": {
          "foreground": "#C8F5E0",
          "fontStyle": ""
        }
      }
    ]
  },
  // 输入 {} 时补全为 {};（用于类/结构体定义末尾）
  //参数提示
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "all",
  // ===== 内联提示（inlay hints）颜色：调暗参数提示 =====
  // 注意：内联提示颜色由主题颜色键控制，不能用 textMateRules 的 scope 设置。
  // 这里统一调暗所有内联提示（参数名、变量类型、返回类型等）。
  "workbench.colorCustomizations": {
    "editorInlayHint.foreground": "#5A5A5A",
    "editorInlayHint.background": "#00000000",
    "editorInlayHint.parameterForeground": "#5A5A5A",
    "editorInlayHint.parameterBackground": "#00000000",
    "editorInlayHint.typeForeground": "#5A5A5A",
    "editorInlayHint.typeBackground": "#00000000"
  },
  "python.REPL.enableREPLSmartSend": false,
  "python-envs.defaultEnvManager": "ms-python.python:system",
  // ===== C/C++ IntelliSense：指定 MinGW g++ 编译器，自动解析标准库头文件 =====
  "C_Cpp.default.compilerPath": "D:\\MinGW\\minGW\\x86_64-16.2.0-release-win32-seh-ucrt-rt_v14-rev1\\mingw64\\bin\\g++.exe",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.cppStandard": "c++17",
  "cmake.sourceDirectory": "D:/myGame",
  // ===== CMake Tools：构建目录与 launch.json 中调试的程序路径保持一致 =====
  "cmake.buildDirectory": "${workspaceFolder}/out/build/${buildKit}"
}