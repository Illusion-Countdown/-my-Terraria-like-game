{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++.exe 生成活动文件",
			"command": "D:\\MinGW\\minGW\\x86_64-16.2.0-release-win32-seh-ucrt-rt_v14-rev1\\mingw64\\bin\\g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"-finput-charset=UTF-8",
				"-fexec-charset=UTF-8",
				"${file}",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "调试器生成的任务。"
		},
		{
			"label": "编译 SpeechContestMS",
			"type": "shell",
			"command": "g++",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"-finput-charset=UTF-8",
				"-fexec-charset=UTF-8",
				"main.cpp",
				"Menu.cpp",
				"Clear.cpp",
				"Review.cpp",
				"Compete.cpp",
				"Compare.cpp",
				"Player.cpp",
				"Save.cpp",
				"Update.cpp",
				"MS.cpp",
				"-o",
				"main.exe"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	],
	"version": "2.0.0"
}